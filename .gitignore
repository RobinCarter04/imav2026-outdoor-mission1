# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ---- Flight data, logs, models (large / per-run; keep READMEs + .gitkeep) ----
data/flights/*
!data/flights/.gitkeep
data/datasets/*
!data/datasets/.gitkeep
data/models/*
data/plans/
!data/models/.gitkeep
!data/models/MANIFEST.md
*.tlog
*.tlog.raw
*.BIN
*.bin
*.tflite
*.onnx
*.pt
*.mp4
*.MOV
*.MP4

# ---- ArduPilot SITL runtime junk ----
sim/runtime/
logs/
terrain/
eeprom.bin
mav.parm
mav.tlog*
*.parm.bak

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- Secrets ----
.env
*.pem

# the rulebook PDF is not tracked — download it from the link in docs/project/rulebook/README.md
docs/project/rulebook/*.pdf
